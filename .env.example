# Copy to .env and adjust. docker compose reads .env automatically; for
# `go run` export the variables in your shell.

# Required by the server.
DATABASE_URL=postgres://workout:workout@localhost:5432/workout?sslmode=disable

# Optional.
PORT=8080
LOG_LEVEL=info
SESSION_TTL=720h
SECURE_COOKIES=false
SEED_DEMO=true

# Integration tests (go test ./...) skip themselves without this.
TEST_DATABASE_URL=postgres://workout:workout@localhost:5432/workout_test?sslmode=disable

# docker compose only.
WEB_PORT=4413
DB_PORT=5432
